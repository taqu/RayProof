cmake_minimum_required(VERSION 3.25)
project(thirdparty NONE)
include(ExternalProject)

ExternalProject_Add(mimalloc
    GIT_REPOSITORY https://github.com/microsoft/mimalloc.git
    GIT_TAG v2.1.7
    PREFIX "${THIRDPARTY_DIR}/mimalloc"
    CMAKE_ARGS "-DCMAKE_INSTALL_PREFIX=${THIRDPARTY_DIR}/mimalloc"
        "-DCMAKE_DEBUG_POSTFIX=d"
)

ExternalProject_Add(glew
    URL https://github.com/nigels-com/glew/releases/download/glew-2.2.0/glew-2.2.0.zip
    PREFIX "${THIRDPARTY_DIR}/glew"
    CMAKE_ARGS "-DCMAKE_INSTALL_PREFIX=${THIRDPARTY_DIR}/glew" "-DCMAKE_DEBUG_POSTFIX=d"
    SOURCE_SUBDIR "build/cmake"
)

ExternalProject_Add(fltk
    GIT_REPOSITORY https://github.com/fltk/fltk.git
    GIT_TAG release-1.4.2
    PREFIX "${THIRDPARTY_DIR}/fltk"
    CMAKE_ARGS "-DCMAKE_INSTALL_PREFIX=${THIRDPARTY_DIR}/fltk"
)

